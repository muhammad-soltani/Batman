# Copy to .env (git-ignored) and adjust. docker compose reads this file automatically.

# Optional proxy used only while building images (not stored in the images).
# HTTP_PROXY=http://127.0.0.1:9815
# HTTPS_PROXY=http://127.0.0.1:9815
# NO_PROXY=localhost,127.0.0.1

# Max characters per text (backend limit and frontend counter use the same value).
# MAX_TEXT_LENGTH=50000

# Simultaneous model inferences (raise on machines with many cores / a GPU).
# MAX_CONCURRENT_INFERENCE=2

# Comma-separated browser origins allowed to call the API directly (CORS).
# CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Backend URL used by the browser. Leave empty when a reverse proxy (your
# server's nginx) routes /api/* to the backend. For local use without a proxy:
# API_BASE_URL=http://localhost:8000

# Matching rule: semantic similarity above SIMILARITY_THRESHOLD, or a near-verbatim
# copy with lexical similarity >= LEXICAL_MATCH_THRESHOLD.
# SIMILARITY_THRESHOLD=0.7
# LEXICAL_MATCH_THRESHOLD=0.8
